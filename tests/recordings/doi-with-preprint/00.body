{"status":"ok","message-type":"work","message-version":"1.0.0","message":{"indexed":{"date-parts":[[2025,12,5]],"date-time":"2025-12-05T19:30:37Z","timestamp":1764963037067,"version":"3.46.0"},"reference-count":13,"publisher":"Springer Science and Business Media LLC","issue":"3","license":[{"start":{"date-parts":[[2025,11,19]],"date-time":"2025-11-19T00:00:00Z","timestamp":1763510400000},"content-version":"tdm","delay-in-days":0,"URL":"https:\/\/creativecommons.org\/licenses\/by\/4.0"},{"start":{"date-parts":[[2025,11,19]],"date-time":"2025-11-19T00:00:00Z","timestamp":1763510400000},"content-version":"vor","delay-in-days":0,"URL":"https:\/\/creativecommons.org\/licenses\/by\/4.0"}],"content-domain":{"domain":["link.springer.com"],"crossmark-restriction":false},"short-container-title":["J. Geom."],"published-print":{"date-parts":[[2025,12]]},"abstract":"<jats:title>Abstract<\/jats:title>\n                  <jats:p>\n                    We introduce the notion of\n                    <jats:inline-formula>\n                      <jats:alternatives>\n                        <jats:tex-math>$$P_{\\lambda }$$<\/jats:tex-math>\n                        <mml:math xmlns:mml=\"http:\/\/www.w3.org\/1998\/Math\/MathML\">\n                          <mml:msub>\n                            <mml:mi>P<\/mml:mi>\n                            <mml:mi>\u03bb<\/mml:mi>\n                          <\/mml:msub>\n                        <\/mml:math>\n                      <\/jats:alternatives>\n                    <\/jats:inline-formula>\n                    points, which canonically parametrize points on the Euler line. This allows us to show that the Euler line of any\n                    <jats:italic>d<\/jats:italic>\n                    -dimensional inscribed polygon in Euclidean space arises from the Euler lines of its sub-polygons, beginning from the Euler line of a point in the plane. Furthermore, we situate\n                    <jats:inline-formula>\n                      <jats:alternatives>\n                        <jats:tex-math>$$P_{\\lambda }$$<\/jats:tex-math>\n                        <mml:math xmlns:mml=\"http:\/\/www.w3.org\/1998\/Math\/MathML\">\n                          <mml:msub>\n                            <mml:mi>P<\/mml:mi>\n                            <mml:mi>\u03bb<\/mml:mi>\n                          <\/mml:msub>\n                        <\/mml:math>\n                      <\/jats:alternatives>\n                    <\/jats:inline-formula>\n                    points in the literature of modern triangle centers.\n                  <\/jats:p>","DOI":"10.1007\/s00022-025-00782-5","type":"journal-article","created":{"date-parts":[[2025,11,19]],"date-time":"2025-11-19T05:36:37Z","timestamp":1763530597000},"update-policy":"https:\/\/doi.org\/10.1007\/springer_crossmark_policy","source":"Crossref","is-referenced-by-count":0,"title":["Cycling along Euler road"],"prefix":"10.1007","volume":"116","author":[{"given":"Dylan","family":"Wyrzykowski","sequence":"first","affiliation":[],"role":[{"role":"author","vocabulary":"crossref"}]}],"member":"297","published-online":{"date-parts":[[2025,11,19]]},"reference":[{"key":"782_CR1","doi-asserted-by":"publisher","first-page":"108","DOI":"10.2307\/3614382","volume":"51","author":"SN Collings","year":"1967","unstructured":"Collings, S.N.: Cyclic polygons and their Euler lines. Math. Gaz. 51, 108\u2013114 (1967). https:\/\/doi.org\/10.2307\/3614382","journal-title":"Math. Gaz."},{"key":"782_CR2","doi-asserted-by":"publisher","first-page":"1","DOI":"10.4171\/EM\/238","volume":"69","author":"B Herrera G\u00f3mez","year":"2014","unstructured":"Herrera G\u00f3mez, B.: The Feuerbach circle and the other remarkable circles of the cyclic polygons. Elem. Math. 69, 1\u201310 (2014). https:\/\/doi.org\/10.4171\/EM\/238","journal-title":"Elem. Math."},{"key":"782_CR3","doi-asserted-by":"publisher","DOI":"10.1016\/C2013-0-12585-8","volume-title":"Complex Numbers in Geometry","author":"IM Yaglom","year":"1968",