<xref rid="B29" ref-type="bibr">Farina et al. (2020)</xref>
</td><td valign="top" align="left" rowspan="1" colspan="1">sMRI</td><td valign="top" align="left" rowspan="1" colspan="1">Elastic net</td><td valign="top" align="left" rowspan="1" colspan="1">450 subjects</td><td valign="top" align="left" rowspan="1" colspan="1">AD vs. CN</td><td valign="top" align="center" rowspan="1" colspan="1">94</td><td valign="top" align="center" rowspan="1" colspan="1">0.90</td><td valign="top" align="center" rowspan="1" colspan="1">0.94</td></tr><tr><td valign="top" align="left" rowspan="1" colspan="1">
<xref rid="B30" ref-type="bibr">Feng et al. (2020)</xref>
</td><td valign="top" align="left" rowspan="1" colspan="1">sMRI</td><td valign="top" align="left" rowspan="1" colspan="1">NN</td><td valign="top" align="left" rowspan="1" colspan="1">480 subjects</td><td valign="top" align="left" rowspan="1" colspan="1">AD vs. CN</td><td valign="top" align="center" rowspan="1" colspan="1">82</td><td valign="top" align="center" rowspan="1" colspan="1">0.78</td><td valign="top" align="center" rowspan="1" colspan="1">0.82</td></tr><tr><td valign="top" align="left" rowspan="1" colspan="1">
<xref rid="B59" ref-type="bibr">Lei et al. (2020)</xref>
</td><td valign="top" align="left" rowspan="1" colspan="1">fMRI, DTI</td><td valign="top" align="left" rowspan="1" colspan="1">SVM</td><td valign="top" align="left" rowspan="1" colspan="1">170 subjects</td><td valign="top" align="left" rowspan="1" colspan="1">AD vs. CN</td><td valign="top" align="center" rowspan="1" colspan="1">85.23</td><td valign="top" align="center" rowspan="1" colspan="1">0.82</td><td valign="top" align="center" rowspan="1" colspan="1">0.85</td></tr><tr><td valign="top" align="left" rowspan="1" colspan="1">
<xref rid="B12" ref-type="bibr">Bron et al. (2021)</xref>
