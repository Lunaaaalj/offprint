</td><td valign="top" align="left" rowspan="1" colspan="1">EEG</td><td valign="top" align="left" rowspan="1" colspan="1">GAN</td><td valign="top" align="left" rowspan="1" colspan="1">283 subjects</td><td valign="top" align="left" rowspan="1" colspan="1">AD vs. CN</td><td valign="top" align="center" rowspan="1" colspan="1">75</td><td valign="top" align="center" rowspan="1" colspan="1">0.98</td><td valign="top" align="center" rowspan="1" colspan="1">0.98</td></tr><tr><td valign="top" align="left" rowspan="1" colspan="1">
<xref rid="B103" ref-type="bibr">Thangavel et al. (2023)</xref>
</td><td valign="top" align="left" rowspan="1" colspan="1">MRI</td><td valign="top" align="left" rowspan="1" colspan="1">EAD-DNN (deep ResNet and deep CNN)</td><td valign="top" align="left" rowspan="1" colspan="1">ADNI</td><td valign="top" align="left" rowspan="1" colspan="1">AD vs. CN</td><td valign="top" align="center" rowspan="1" colspan="1">98</td><td valign="top" align="center" rowspan="1" colspan="1">0.90</td><td valign="top" align="center" rowspan="1" colspan="1">0.94</td></tr><tr><td valign="top" align="left" rowspan="1" colspan="1">
<xref rid="B68" ref-type="bibr">Lu et al. (2024)</xref>
</td><td valign="top" align="left" rowspan="1" colspan="1">MRI, PET, cognitive</td><td valign="top" align="left" rowspan="1" colspan="1">Hierarchical attention MLP</td><td valign="top" align="left" rowspan="1" colspan="1">ADNI</td><td valign="top" align="left" rowspan="1" colspan="1">Multiclass (CN vs. MCI vs. AD)</td><td valign="top" align="center" rowspan="1" colspan="1">87</td><td valign="top" align="center" rowspan="1" colspan="1">0.88</td><td valign="top" align="center" rowspan="1" colspan="1">0.85</td></tr><tr><td valign="top" align="left" rowspan="1" colspan="1">
<xref rid="B108" ref-type="bibr">Zhang et al. (2024)</xref>
</td><td valign="top" align="left" rowspan="1" colspan="1">MRI, PET</td><td valign="top" align="left" rowspan="1" colspan="1">Pyramid-attentive GAN</td><td valign="top" align="left" rowspan="1" colspan="1">370 subjects from ADNI</td><td valign="top" align="left" rowspan="1" colspan="1">Multiclass (CN vs. MCI vs. AD)</td><td valign="top" align="center" rowspan="1" colspan="1">89.9</td><td valign="top" align="center" rowspan="1" colspan="1">0.83</td><td valign="top" align="center" rowspan="1" colspan="1">0.83</td></tr><tr><td valign="top" align="left" rowspan="1" colspan="1">
<xref rid="B104" ref-type="bibr">Tu et al. (2024)</xref>
